{
  "manifest_version": 3,
  "name": "YouTube AI Classifier",
  "description": "AI-powered credibility scoring for YouTube videos",
  "version": "2.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8080/*", "https://ytclassifier.xyz/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "test.jpg"
  },
  "icons": {
    "16": "test.jpg",
    "32": "test.jpg",
    "48": "test.jpg",
    "128": "test.jpg"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js"],
      "matches": ["*://www.youtube.com/*"]
    }
  ]
}